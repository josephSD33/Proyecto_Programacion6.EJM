@model List<DataModels.PviProyectoFinalDBStoredProcedures.SpReadServiciosResult>

@{
    ViewBag.Title = "Servicios";
}

<div class="card">

    <h2 class="titulo">Lista de Servicios</h2>

    <a href="@Url.Action("Guardar", "Servicio")" class="btn btn-primary mb-3">
        + Nuevo Servicio
    </a>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success">@ViewBag.Mensaje</div>
    }

    @if (TempData["resultado"] != null)
    {
        <div class="alert alert-info">@TempData["resultado"]</div>
    }

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Categoría</th>
                <th>Estado</th>
                <th>Acción</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                var estado = item.Estado != null ? item.Estado.ToString().ToUpper().Trim() : "";

                <tr>
                    <td>@item.Id_servicio</td>
                    <td>@item.Nombre</td>
                    <td>₡ @item.Precio</td>
                    <td>@item.Categoria</td>

                    <td>
                        @if (estado == "ACTIVO")
                        {
                            <span class="estado-activo">@item.Estado</span>
                        }
                        else
                        {
                            <span class="estado-inactivo">@item.Estado</span>
                        }
                    </td>

                    <td>
                        <a href="@Url.Action("Guardar", "Servicio", new { id = item.Id_servicio })"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a href="@Url.Action("Inactivar", "Servicio", new { id = item.Id_servicio })"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('¿Seguro que desea inactivar este servicio?');">
                            Inactivar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
