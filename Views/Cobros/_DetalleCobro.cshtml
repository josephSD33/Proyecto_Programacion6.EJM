
@model Proyecto_Programacion6.Models.DetalleCobroViewModel

@{
    var cobro = Model == null ? null : Model.Cobro;
}

@if (cobro == null)
{
    <div class="alert alert-danger">
        @(ViewBag.resultado ?? "No se encontró el cobro.")
    </div>
}
else
{
    <h4>Información del cobro</h4>

    <table class="table table-bordered">
        <tr>
            <th>Número</th>
            <td>@cobro.IdCobro</td>
        </tr>
        <tr>
            <th>Cliente</th>
            <td>@cobro.Cliente</td>
        </tr>
        <tr>
            <th>Casa</th>
            <td>@cobro.Casa</td>
        </tr>
        <tr>
            <th>Período</th>
            <td>@cobro.Mes / @cobro.Anno</td>
        </tr>
        <tr>
            <th>Estado</th>
            <td>@cobro.Estado</td>
        </tr>
        <tr>
            <th>Fecha de pago</th>
            <td>
                @(cobro.FechaPagada == null
                    ? "Sin pagar"
                    : string.Format("{0:dd/MM/yyyy}", cobro.FechaPagada))
            </td>
        </tr>
        <tr>
            <th>Monto</th>
            <td>$ @string.Format("{0:N2}", cobro.Monto)</td>
        </tr>
    </table>

    <h4>Servicios</h4>

    if (Model.Servicios != null && Model.Servicios.Any())
    {
        <ul>
            @foreach (var servicio in Model.Servicios)
            {
                <li>
                    @servicio.Nombre -
                    $ @string.Format("{0:N2}", servicio.Precio)
                </li>
            }
        </ul>
    }
    else
    {
        <p>No hay servicios asociados.</p>
    }

    <h4>Bitácora</h4>

    if (Model.Bitacora != null && Model.Bitacora.Any())
    {
        <table class="table table-bordered">
            <tr>
                <th>Fecha</th>
                <th>Acción</th>
                <th>Persona</th>
            </tr>

            @foreach (var registro in Model.Bitacora)
            {
                <tr>
                    <td>
                        @string.Format("{0:dd/MM/yyyy HH:mm}",
                                 registro.Fecha)
                    </td>
                    <td>@registro.Detalle</td>
                    <td>@registro.Persona</td>
                </tr>
            }
        </table>
    }
    else
    {
        <p>No hay registros en la bitácora.</p>
    }

    if (Model.EsEmpleado && cobro.Estado == "Pendiente")
    {
        <div class="mb-3">

            @Html.ActionLink("Editar", "Editar", "Cobros",
                     new { id = cobro.IdCobro },
                     new { @class = "btn btn-primary" })

            @using (Html.BeginForm("Pagar", "Cobros",
                new { id = cobro.IdCobro }, FormMethod.Post,
                new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success"
                        onclick="return confirm('¿Registrar el pago?');">
                    Pagar
                </button>
            }

            @using (Html.BeginForm("Eliminar", "Cobros",
                new { id = cobro.IdCobro }, FormMethod.Post,
                new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('¿Eliminar este cobro?');">
                    Eliminar
                </button>
            }

        </div>
    }
}

<button type="button"
        id="btnCerrarDetalle"
        class="btn btn-secondary">
    Cerrar
</button>
