
@model List<DataModels.PviProyectoFinalDBStoredProcedures.SpListarCobrosResult>

@{
    ViewBag.Title = ViewBag.Titulo;
    bool esEmpleado = ViewBag.EsEmpleado == true;
    var meses = System.Globalization.CultureInfo
        .GetCultureInfo("es-CR").DateTimeFormat;
}

<h2>@ViewBag.Titulo</h2>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-@((ViewBag.MensajeTipo as string) ?? "danger")">
        @ViewBag.Mensaje
    </div>
}


@if (esEmpleado)
{
    using (Html.BeginForm("Gestionar", "Cobros", FormMethod.Get))
    {
        <div class="row mb-3">

            <div class="col-md-4">
                <label>Cliente</label>

                @Html.DropDownList(
                         "idCliente",
                         (SelectList)ViewBag.Clientes,
                         "Todos los clientes",
                         new { @class = "form-control" })
            </div>

            <div class="col-md-4">
                <label>Año</label>

                <select name="anno" class="form-control">
                    <option value="">Todos los años</option>

                    @for (int a = 2024; a <= 2034; a++)
                    {
                        <option value="@a"
                                @(ViewBag.Anno == a ? "selected" : "")>
                            @a
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label>Mes</label>

                <select name="mes" class="form-control">
                    <option value="">Todos los meses</option>

                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m"
                                @(ViewBag.Mes == m ? "selected" : "")>
                            @meses.GetMonthName(m)
                        </option>
                    }
                </select>
            </div>

        </div>

        <button type="submit" class="btn btn-primary">
            Filtrar
        </button>

        @Html.ActionLink(
                 "Nuevo cobro", "Crear", "Cobros",
                 null, new { @class = "btn btn-success" })
    }
}


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th># Cobro</th>
            @if (esEmpleado)
            {
                <th>Cliente</th>
            }
            <th>Casa</th>
            <th>Período</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.IdCobro</td>
                @if (esEmpleado)
                {
                    <td>@c.Cliente</td>
                }
                <td>@c.Casa</td>
                <td>@c.Periodo</td>
                <td>@c.Estado</td>
                <td>
                    <button type="button"
                            class="btn btn-primary btnConsultar"
                            data-id="@c.IdCobro">
                        Consultar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>No hay cobros para mostrar.</p>
}

<div id="dialog" title="Detalle del cobro"></div>

@section Scripts {
    <script>
    $(function () {

        $("#dialog").dialog({
            autoOpen: false,
            modal: true,
            width: 800,
            maxHeight: $(window).height() - 60
        });

        $(".btnConsultar").click(function () {

            $.get('@Url.Action("Detalle", "Cobros")',
                { id: $(this).data("id") },
                function (html) {
                    $("#dialog").html(html).dialog("open");
                }
            ).fail(function () {
                alert("No se pudo cargar el detalle.");
            });
        });

        $(document).on("click", "#btnCerrarDetalle", function () {
            $("#dialog").dialog("close");
        });
    });
    </script>
}


