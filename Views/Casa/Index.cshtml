@model List<DataModels.PviProyectoFinalDBStoredProcedures.SpReadCasasResult>
@{
    ViewBag.Title = "Gestión de Casas";
}
@Html.ActionLink("Nueva casa", "Crear", "Casa", null, new { @class = "btn btn-primary" })
<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Id</th>
            <th>Casa</th>
            <th>Metros Cuadrados</th>
            <th>Habitaciones</th>
            <th>Baños</th>
            <th>Propietario</th>
            <th>Construcción</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var casa in Model)
        {
            <tr>
                <td>@casa.Id_casa</td>
                <td>@casa.Nombre_casa</td>
                <td>@casa.Metros_cuadrados</td>
                <td>@casa.Numero_habitaciones</td>
                <td>@casa.Numero_banos</td>
                <td>@casa.NumeroPropietario</td>
                <td>@casa.Fecha_construccion.ToShortDateString()</td>

                <td>@(casa.Estado == true ? "Activa" : "Inactiva")</td>
                <td>
                    @if (casa.Estado == true)
                    {
                        @Html.ActionLink("Editar", "Editar", "Casas", new { id = casa.Id_casa, }, null)
                    }
                </td>
            </tr>
        }
    </tbody>


</table>
@if (Model.Count == 0)
{
    <p>No hay casas para mostrar.</p>
}